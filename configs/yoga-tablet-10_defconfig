CONFIG_ARM=y
CONFIG_ARCH_MEDIATEK=y
CONFIG_TARGET_MT6589=y
CONFIG_TARGET_YOGA_TABLET_10=y
CONFIG_DEFAULT_DEVICE_TREE="mt6589-yoga-tablet-10"

CONFIG_LEAVE_MEDIATEK=y
#CONFIG_SYS_VENDOR="lenovo"
#CONFIG_SYS_BOARD="yoga-tablet-10"

# maybe nonsense
CONFIG_SYS_LOAD_ADDR=0x82000000

# Address when loaded from LittleKernel
CONFIG_TEXT_BASE=0x80008000

# for 2nd bootloader
CONFIG_LINUX_KERNEL_IMAGE_HEADER=y
#CONFIG_SKIP_LOWLEVEL_INIT=y
CONFIG_SPL=n
#CONFIG_BOARD_EARLY_INIT_F=n

# postmarketOS
CONFIG_POSITION_INDEPENDENT=y
#CONFIG_SYS_MALLOC_LEN
#CONFIG_DEBUG_UART=y
#CONFIG_DEBUG_UART_SKIP_INIT=y
CONFIG_LOGLEVEL=8

### Drivers

## Driver Model (DM)
CONFIG_DM_RESET=y
CONFIG_DM_MMC=y
CONFIG_DM_STDIO=y
CONFIG_DM_SERIAL=y
CONFIG_DM_USB=y
CONFIG_DM_PMIC=y
CONFIG_DM_REGULATOR=y
CONFIG_DM_REGULATOR_FIXED=y
CONFIG_DM_KEYBOARD=y
CONFIG_DM_GPIO=y

## timer
CONFIG_TIMER=y
CONFIG_MTK_TIMER=y

## uart
CONFIG_SERIAL=y
CONFIG_DM_SERIAL=y
CONFIG_MTK_SERIAL=y

## Display
CONFIG_VIDEO=y
CONFIG_VIDEO_SIMPLE=y
CONFIG_VIDEO_DT_SIMPLEFB=y

## watchdog
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_AUTOSTART=y
CONFIG_WDT=y
CONFIG_WDT_MTK=y

## USB
CONFIG_USB=y
CONFIG_PHY=y
CONFIG_PHY_MTK_TPHY=y
#CONFIG_USB_MUSB_HOST=y

### Android fastboot
CONFIG_USB_GADGET_DOWNLOAD=y
CONFIG_USB_GADGET_VENDOR_NUM=0x0bb4
CONFIG_USB_GADGET_PRODUCT_NUM=0x0c01
CONFIG_USB_GADGET_MANUFACTURER"Lenovo"

## Clock
CONFIG_CLK=y
